# AttestPay agent — copy to .env and fill. NEVER commit .env.
# RPC (testnet 968 or mainnet 677)
RPC_URL=https://rpc.bohr.life
# Deployed pool address (from forge deploy / broadcast log)
POOL_ADDRESS=
# Payment token (WBOT — same address on mainnet + testnet)
PAYMENT_TOKEN=0xD5452816194a3784dBa983426cCe7c122F4abd30
# Keys (testnet throwaway only. Mainnet: user-owned keys, never shared)
AGENT_PK=
OWNER_PK=
# Optional LLM verification endpoint (OpenAI-compatible)
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# Agent state file (gitignored)
AGENT_STATE_FILE=.agent-state.json